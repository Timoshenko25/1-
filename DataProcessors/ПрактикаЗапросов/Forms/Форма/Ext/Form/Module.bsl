&НаСервереБезКонтекста
Процедура ИтогиИРазрезыНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК КоличествоЗаписей,
		|	ЕСТЬNULL(СУММА(РеализацияТоваров.СуммаДокумента), 0) КАК СуммаДокументов
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|ГДЕ
		|	РеализацияТоваров.Дата МЕЖДУ ДатаВремя(2025,1,1) И ДатаВремя(2025,12,31,23,59,59)";
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("КоличествоЗаписей: "+ВыборкаДетальныеЗаписи.КоличествоЗаписей+"СуммаДокумента:"+ВыборкаДетальныеЗаписи.СуммаДокументов);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваров.Контрагент КАК Контрагент,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваров.Ссылка) КАК КоличествоДокументов,
		|	СУММА(РеализацияТоваров.СуммаДокумента) КАК СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваров.Контрагент";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("Контрагент"+ВыборкаДетальныеЗаписи.Контрагент+"КоличествоЗаписей: "+ВыборкаДетальныеЗаписи.КоличествоДокументов+" СуммаДокумента:"+ВыборкаДетальныеЗаписи.СуммаДокумента);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваров.Ссылка) КАК Ссылка,
		|	СУММА(РеализацияТоваров.СуммаДокумента) КАК СуммаДокумента,
		|	РеализацияТоваров.Контрагент КАК Контрагент,
		|	РеализацияТоваров.Организация КАК Организация
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваров.Контрагент,
		|	РеализацияТоваров.Организация";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("Организация"+ВыборкаДетальныеЗаписи.Организация+"Контрагент"+ВыборкаДетальныеЗаписи.Контрагент+"КоличествоЗаписей: "+ВыборкаДетальныеЗаписи.Ссылка+" СуммаДокумента:"+ВыборкаДетальныеЗаписи.СуммаДокумента);
	КонецЦикла;
КонецПроцедуры

