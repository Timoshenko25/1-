
&НаСервереБезКонтекста
Процедура ВыборкаНаСервере()
	// Вставить содержимое обработчика.
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5
	               |	Номенклатура.Код КАК Код,
	               |	Номенклатура.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
	
		 Сообщить("Код: "+Выборка.Код+" Товар : "+Выборка.Наименование);
	
	КонецЦикла;
	 //Если добавить в запрос РАЗЛИЧНЫЕ, то он не будет выводить повторяющиеся значения в документе, с этим значением выводиться 5 значений, без него 12
	 Запрос = Новый Запрос();
	 Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                |	РеализацияТоваров.Контрагент КАК Контрагент
	                |ИЗ
	                |	Документ.РеализацияТоваров КАК РеализацияТоваров";
	 Результат = Запрос.Выполнить();
	 Выборка = Результат.Выбрать();
	 Пока Выборка.Следующий() Цикл
	 
	 	  Сообщить("Контрагент: "+Выборка.Контрагент);
	 
	 КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Выборка(Команда)
	ВыборкаНаСервере();
КонецПроцедуры 

&НаСервереБезКонтекста
Процедура УсловияИПараметрыНаСервере()  
	//  Первое
	Упаковка = Справочники.ЕдиницыИзмерения.НайтиПоНаименованию("упак");
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Наименование КАК Наименование,
	               |	Номенклатура.Артикул КАК Артикул
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.ЭтоГруппа = ЛОЖЬ
	               |	И Номенклатура.Артикул <> """"
	               |	И Номенклатура.ЕдиницаИзмерения = &ЕдиницаИзмерения
	               |	И Номенклатура.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",Упаковка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
	
		 Сообщить("Номенклатура: "+Выборка.Наименование+" Артикул: "+Выборка.Артикул);
	
	 КонецЦикла; 
	 //  Второе 
	 // При использовании КонецДня выводится на один документ большее так как при исползовании у нас берется все занения с этой датой независомо от времени
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваров.Номер КАК Номер,
	               |	РеализацияТоваров.Дата КАК Дата
	               |ИЗ
	               |	Документ.РеализацияТоваров КАК РеализацияТоваров
	               |ГДЕ
	               |	РеализацияТоваров.Дата МЕЖДУ &Начало И &Конец"; 
	Запрос.УстановитьПараметр("Начало",'20260601000000');
	Запрос.УстановитьПараметр("Конец",КонецДня('20260630000000'));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
	
		 Сообщить("Номер: "+Выборка.Номер+" Дата: "+Выборка.Дата);
	
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УсловияИПараметры(Команда)
	УсловияИПараметрыНаСервере();
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура ПредопределенныйЗначенияНаСервере()
	// Первый   
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Услуга)";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
		 Сообщить("Услуга: " + Выборка.Наименование);
	КонецЦикла; 
	 // Второй 
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
	               |	И Номенклатура.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.ЕдиницыИзмерения.Штука)";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
		 Сообщить("Товар: " + Выборка.Наименование);
	КонецЦикла;
	 // Третий   
	 //  Упаковку нельзя использовать с Значением  так как упак не являеться предопределным значением и нужно использовать НайтиПоНаименованию
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваров.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваров КАК РеализацияТоваров
	               |ГДЕ
	               |	РеализацияТоваров.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий()  Цикл
		 Сообщить("Документ: " + Выборка.Ссылка);
	 КонецЦикла;
КонецПроцедуры

