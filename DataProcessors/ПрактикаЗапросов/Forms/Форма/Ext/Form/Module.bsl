Процедура ПродажиПоМесяцамНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(РеализацияТоваров.СуммаДокумента) КАК Сумма,
		|	КОЛИЧЕСТВО(РеализацияТоваров.Ссылка) КАК Ссылка,
		|	НАЧАЛОПЕРИОДА(РеализацияТоваров.Дата, МЕСЯЦ) КАК Месяц
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|ГДЕ
		|	РеализацияТоваров.Дата МЕЖДУ ДАТАВРЕМЯ(2026, 6, 1) И ДАТАВРЕМЯ(2026, 9, 1)
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(РеализацияТоваров.Дата, МЕСЯЦ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Месяц";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		//Сообщить(ВыборкаДетальныеЗаписи.Сумма,ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.Месяц);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(РеализацияТоваровТовары.Ссылка.Дата, МЕСЯЦ) КАК Дата,
		|	КОЛИЧЕСТВО(РеализацияТоваровТовары.Номенклатура) КАК Номенклатура
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(РеализацияТоваровТовары.Ссылка.Дата, МЕСЯЦ)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("ДАТА: "+ВыборкаДетальныеЗаписи.Дата+"Количество товаров: "+ВыборкаДетальныеЗаписи.Номенклатура);
	КонецЦикла;
		
КонецПроцедуры

