&НаСервереБезКонтекста
Процедура УсловиеНаГруппировкуНаСервере() 
	Порог = 1500;
	//   Используется условие ИМЕЮЩИЕ так как я использую агрегацию для поля сумма дркумента и сразу отбрасываем значения которые будут меньше порогового
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваров.Контрагент КАК Контрагент,
		|	СУММА(РеализацияТоваров.СуммаДокумента) КАК СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваров.Контрагент
		|
		|ИМЕЮЩИЕ
		|	СУММА(РеализацияТоваров.СуммаДокумента) > &Порог";
	
	Запрос.УстановитьПараметр("Порог", Порог);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("Контрагент: "+ВыборкаДетальныеЗаписи.Контрагент+" СуммаДокумента"+ВыборкаДетальныеЗаписи.СуммаДокумента);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровТовары.Ссылка.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.Ссылка.Ссылка
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РеализацияТоваровТовары.Номенклатура) > 2";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		  Сообщить("Документы:"+ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
КонецПроцедуры

