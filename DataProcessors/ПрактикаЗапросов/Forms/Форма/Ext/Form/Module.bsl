Процедура ПоказатьСтруктуруХранения()
    ИменаОбъектов = Новый Массив;  
	ИменаОбъектов.Добавить("Справочник.Контрагенты");
    ИменаОбъектов.Добавить("Документ.РеализацияТоваров");
    Структура = ПолучитьСтруктуруХраненияБазыДанных(ИменаОбъектов);

    Для Каждого Таблица Из Структура Цикл
        Сообщить(Таблица.ИмяТаблицы + " - " + Таблица.ИмяТаблицыХранения);
        Для Каждого Поле Из Таблица.Поля Цикл
            Сообщить("    " + Поле.ИмяПоля + " - " + Поле.ИмяПоляХранения);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

