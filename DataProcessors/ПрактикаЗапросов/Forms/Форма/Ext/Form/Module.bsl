Процедура ПриходИРасходНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	СУММА(ПоступлениеТоваровТовары.Количество) КАК КоличествоПриход,
		|	0 КАК КоличествоРасход
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	Документ.ПоступлениеТоваров.Товары КАК ПоступлениеТоваровТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	ПоступлениеТоваровТовары.Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровТовары.Номенклатура,
		|	0,
		|	СУММА(РеализацияТоваровТовары.Количество)
		|ИЗ
		|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваровТовары.Номенклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	СУММА(Таблица.КоличествоПриход) КАК КоличествоПриход,
		|	СУММА(Таблица.КоличествоРасход) КАК КоличествоРасход
		|ИЗ
		|	Таблица КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Номенклатура";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить("Номенклатура "+ВыборкаДетальныеЗаписи.Номенклатура+" Приход "+ВыборкаДетальныеЗаписи.КоличествоПриход+" Расход "+ВыборкаДетальныеЗаписи.КоличествоРасход);
	КонецЦикла;
