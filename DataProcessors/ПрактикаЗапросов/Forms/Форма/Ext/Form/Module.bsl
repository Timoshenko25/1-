&НаСервереБезКонтекста
Процедура РейтингПокупателяНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 3
		|	ПРЕДСТАВЛЕНИЕ(РеализацияТоваров.Контрагент) КАК КонтрагентПредставление,
		|	СУММА(РеализацияТоваров.СуммаДокумента) КАК СуммаДокумента
		|ИЗ
		|	Документ.РеализацияТоваров КАК РеализацияТоваров
		|
		|СГРУППИРОВАТЬ ПО
		|	РеализацияТоваров.Контрагент
		|
		|УПОРЯДОЧИТЬ ПО
		|	СуммаДокумента УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить(ВыборкаДетальныеЗаписи.КонтрагентПредставление +" "+ВыборкаДетальныеЗаписи.СуммаДокумента);
	КонецЦикла;
	// Если сортировать по полю конрагент то сортировка будет не по флфавиту а по ссылке, а если берем наименование то сортировка уже по алфавиту
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Сообщить(ВыборкаДетальныеЗаписи.Наименование);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РейтингПокупателя(Команда)
	РейтингПокупателяНаСервере();
КонецПроцедуры

