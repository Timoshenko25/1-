&НаСервереБезКонтекста
Процедура ПоказатьЦеныРеализацииНаСервере(Знач Реализация)
	Для Каждого СтрокаТоваров Из Реализация.Товары Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|   Цены.Цена КАК Цена
		|ИЗ
		|   РегистрСведений.ЦеныНоменклатуры.СрезПоследних() КАК Цены
		|ГДЕ
		|   Цены.Номенклатура = &Товар";
		Запрос.УстановитьПараметр("Товар", СтрокаТоваров.Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДействующаяЦена = 0;
		Если Выборка.Следующий() Тогда
			ДействующаяЦена = Выборка.Цена;
		КонецЕсли;
		
		Сообщить(СтрШаблон("%1 (%2): продано по %3, действующая цена %4",
		СтрокаТоваров.Номенклатура.Наименование, СтрокаТоваров.Номенклатура.Артикул,
		СтрокаТоваров.Цена, ДействующаяЦена));
	КонецЦикла;
КонецПроцедуры  

&НаСервереБезКонтекста
Процедура ПоказатьЦеныРеализацииНаСервере1(Знач Реализация)
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК ДействующаяЦена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ценадейст
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(,) КАК ЦеныНоменклатурыСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеализацияТоваровТовары.Номенклатура.Наименование КАК Наименование,
	|	РеализацияТоваровТовары.Номенклатура.Артикул КАК Артикул,
	|	РеализацияТоваровТовары.Цена КАК Цена,
	|	ценадейст.ДействующаяЦена КАК ДействующаяЦена
	|ИЗ
	|	Документ.РеализацияТоваров.Товары КАК РеализацияТоваровТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ценадейст КАК ценадейст
	|		ПО РеализацияТоваровТовары.Номенклатура = ценадейст.Номенклатура
	|ГДЕ
	|	РеализацияТоваровТовары.Ссылка В(&Ссылка)";
	//Запрос.УстановитьПараметр("Список",СписокТоваров);
	Запрос.УстановитьПараметр("Ссылка",Реализация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл  
		Сообщить(СтрШаблон("%1 (%2): продано по %3, действующая цена %4",
		Выборка.Наименование, Выборка.Артикул,
		Выборка.Цена, Выборка.ДействующаяЦена));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЦеныРеализации(Команда)
	//ПоказатьЦеныРеализацииНаСервере(Реализация);
	ПоказатьЦеныРеализацииНаСервере1(Реализация);
КонецПроцедуры 

 // Модуль формы обработки ПрактикаПроизводительности
&НаСервереБезКонтекста
Процедура ЗаписатьЦеныМолокаНаСервере()
    // Чтение, которому транзакция не нужна, выполняем до неё
    Товар = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", "МЛ-001");
    Если Товар.Пустая() Тогда
        ВызватьИсключение "Товар с артикулом МЛ-001 не найден";
    КонецЕсли;

    НачатьТранзакцию();
    Попытка
        ЗаписатьЦенуПоставщика(Дата(2026, 10, 2), Товар, 83); 
		//ВызватьИсключение "Проверка отмены транзакции";
        ЗаписатьЦенуПоставщика(Дата(2026, 10, 5), Товар, 85);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("Учебная база.Запись цен поставщика", УровеньЖурналаРегистрации.Ошибка, , ,
            ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьЦеныПоставщиков(Команда)
	ЗаписатьЦеныМолокаНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьЦенуПоставщика (Знач Дата,знач Номенклатура,знач цена )

	Запись = РегистрыСведений.ЦеныПоставщиков.СоздатьНаборЗаписей();
	Запись.Отбор.Период.Установить(Дата);
	Запись.Отбор.Номенклатура.Установить(Номенклатура);
	НоваяЗапись = Запись.Добавить();
	НоваяЗапись.Период = Дата;
	НоваяЗапись.Номенклатура = Номенклатура;
	НоваяЗапись.Цена = цена; 
	Запись.Записать();

КонецПроцедуры 

