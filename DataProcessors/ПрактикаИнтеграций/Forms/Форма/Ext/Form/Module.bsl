
&НаКлиенте
Процедура ВывестиОстатки(Команда)
	Результат = ОстаткиВJSON();
	ТекстОбмена = Результат;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОстаткиВJSON()
	Возврат УчебныйОбмен.ЗначениеВСтрокуJSON(УчебныйОбмен.ОстаткиТоваров()); 
КонецФункции

&НаКлиенте
Процедура СуммаОстатковИзJSON(Команда)
	Результат =  СуммаОстатковВJSON(ТекстОбмена);  
	Сообщить(Результат);
КонецПроцедуры

&НаСервереБезКонтекста
Функция СуммаОстатковВJSON(ТекстОбмена)
	Возврат УчебныйОбмен.СуммаОстатковИзJSON(ТекстОбмена);
КонецФункции  

&НаКлиенте
Процедура ЧислоПрочитаныхЭлементов(Команда)
	Результат =  ЧислоПрочитаныхЭлементовНаСервере(ТекстОбмена);  
	Сообщить(Результат);
КонецПроцедуры 

&НаСервереБезКонтекста
Функция ЧислоПрочитаныхЭлементовНаСервере(ТекстОбмена)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстОбмена);
	ДанныеОстатков = ПрочитатьJSON(Чтение, Ложь); // Истина - объекты читать в соответствие
	Чтение.Закрыть();
	Возврат ДанныеОстатков.Количество();
КонецФункции  

