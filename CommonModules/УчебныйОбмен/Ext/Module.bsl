// Общий модуль УчебныйОбмен (флаг «Сервер»)
Функция ОстаткиТоваров() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|   Остатки.Номенклатура.Артикул КАК Артикул,
	|   Остатки.Номенклатура.Наименование КАК Наименование,
	|   Остатки.Склад.Наименование КАК Склад,
	|   Остатки.КоличествоОстаток КАК Количество
	|ИЗ
	|   РегистрНакопления.ТоварыНаСкладах.Остатки() КАК Остатки
	|УПОРЯДОЧИТЬ ПО
	|   Наименование,
	|   Склад";
	
	ДанныеОстатков = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлементДанных = Новый Структура;
		ЭлементДанных.Вставить("sku", Выборка.Артикул);
		ЭлементДанных.Вставить("name", Выборка.Наименование);
		ЭлементДанных.Вставить("warehouse", Выборка.Склад);
		ЭлементДанных.Вставить("quantity", Выборка.Количество);
		ДанныеОстатков.Добавить(ЭлементДанных);
	КонецЦикла;
	Возврат ДанныеОстатков;
КонецФункции

Функция ЗначениеВСтрокуJSON(Знач Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть(); // при записи в строку Закрыть() возвращает текст
КонецФункции

// ЗначениеВСтрокуJSON(ОстаткиТоваров()) вернёт массив объектов вида
// {"sku": "МЛ-001", "name": "Молоко 1 л", "warehouse": "Магазин", "quantity": 40}

Функция СуммаОстатковИзJSON(Знач ТекстJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	ДанныеОстатков = ПрочитатьJSON(Чтение, Истина); // Истина - объекты читать в соответствие
	Чтение.Закрыть();
	
	Итого = 0;
	Для Каждого ЭлементДанных Из ДанныеОстатков Цикл
		Количество = ЭлементДанных.Получить("quantity"); // ключа нет - вернётся Неопределено
		Если ТипЗнч(Количество) <> Тип("Число") Тогда
			ВызватьИсключение "В элементе данных нет числового значения quantity";
		КонецЕсли;
		Итого = Итого + Количество;
	КонецЦикла;
	Возврат Итого;
КонецФункции 

// <?xml version="1.0" encoding="UTF-8"?>
// <stock>
//     <item sku="МЛ-001" warehouse="Магазин" quantity="40">Молоко 1 л</item>
//     <item sku="МЛ-001" warehouse="Основной склад" quantity="15">Молоко 1 л</item>
// </stock>
Функция ОстаткиВXML() Экспорт
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("stock");
	Для Каждого ЭлементДанных Из ОстаткиТоваров() Цикл
		Запись.ЗаписатьНачалоЭлемента("item");
		Запись.ЗаписатьАтрибут("sku", ЭлементДанных.sku);
		Запись.ЗаписатьАтрибут("warehouse", ЭлементДанных.warehouse);
		Запись.ЗаписатьАтрибут("quantity", XMLСтрока(ЭлементДанных.quantity));
		Запись.ЗаписатьТекст(ЭлементДанных.name);
		Запись.ЗаписатьКонецЭлемента(); // item
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // stock
	Возврат Запись.Закрыть();
КонецФункции

Функция СуммаОстатковИзXML(Знач ТекстXML) Экспорт
	Итого = 0;
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя = "item" Тогда
			Итого = Итого + XMLЗначение(Тип("Число"), Чтение.ЗначениеАтрибута("quantity"));
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат Итого;
КонецФункции  

Функция ЗагрузитьЦеныПоставщика(ТекстФайла, ДатаЦен) Экспорт
	
	СтрокаФайла = СтрРазделить(ТекстФайла, Символы.ПС);    
	Результат = Новый Структура; 
	Загружено = 0; 
	МассивОшибок = Новый Массив(); 
	Индекс = 1;  
	Для каждого Строка Из СтрокаФайла Цикл
		Массив1 = СтрРазделить(Строка,";",Ложь);
		Если Массив1.Количество() <= 1 Тогда
			
			Строка = "Ошибка: в строке меньше двух полей";
			МассивОшибок.Добавить(Строка); 
			Продолжить;
			
		КонецЕсли;
		Массив = СтрРазделить(СокрЛП(Массив1.Получить(0))," ",Ложь); 
		Массив.Добавить(Массив1.Получить(1));
		Если  Массив.Количество()  > 3  Тогда
			
			Строка = "Ошибка: в строке более двух полей, номер строки - " + Массив.Получить(0);
			МассивОшибок.Добавить(Строка); 
			Продолжить;
			
		КонецЕсли; 
		ОписаниеЧисла = Новый ОписаниеТипов("Число");
		Если  Массив.Количество() <=  2 Тогда
			
			Строка = "Ошибка: в строке - артикул не заполнен, номер строки - " + Массив.Получить(0);
			МассивОшибок.Добавить(Строка);  
			Продолжить;
			
		КонецЕсли;
        Артикул = СокрЛП(Массив.Получить(1));
		ЦенаСтр = СокрЛП(Массив.Получить(2)); 
		Цена = ОписаниеЧисла.ПривестиЗначение(ЦенаСтр);
		Если Не Цена > 0 Тогда
			
			Строка = "Ошибка: в строке - цена меньше 0, номер строки - " + Массив.Получить(0);
			МассивОшибок.Добавить(Строка);
			Продолжить;
			
		КонецЕсли;
		
		Запись = РегистрыСведений.ЦеныПоставщиков.СоздатьМенеджерЗаписи();
		Запись.Период = ДатаЦен; 
		Номенклатура = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул",Артикул);
		Если Номенклатура.Пустая()  Тогда
			
			Строка = "Ошибка: в строке - номенклатуры с таким артикулом нет, номер строки - " + Массив.Получить(0);
			МассивОшибок.Добавить(Строка);
			Продолжить;
			
		КонецЕсли;
		Запись.Номенклатура = Номенклатура; 
		Запись.Цена = Цена;
		Запись.Записать();   
		Загружено = Загружено+1;
		
	КонецЦикла;
	Результат.Вставить("Загружено", Загружено);
	Результат.Вставить("Отвергнуто",МассивОшибок);
	Возврат Результат;
КонецФункции

// Общий модуль УчебныйОбмен
Функция ПолучитьОстаткиССервиса() Экспорт
    ИмяСобытия = "Учебный обмен.Запрос остатков";

    // Сервер, порт и время ожидания в секундах
    Соединение = Новый HTTPСоединение("localhost", 80, , , , 30);
    ЗапросHTTP = Новый HTTPЗапрос("/uchebnaya/hs/ostatki/items");

    Попытка
        Ответ = Соединение.Получить(ЗапросHTTP);
    Исключение
        // Сервер недоступен или не ответил за отведённое время
        ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
            ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
        ВызватьИсключение;
    КонецПопытки;

    ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
    Если Ответ.КодСостояния <> 200 Тогда
        ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , ,
            СтрШаблон("Код состояния %1. Начало ответа: %2", Ответ.КодСостояния, Лев(ТелоОтвета, 500)));
        ВызватьИсключение СтрШаблон("Сервис остатков вернул код состояния %1", Ответ.КодСостояния);
    КонецЕсли;

    Возврат ТелоОтвета;
КонецФункции

// Общий модуль УчебныйОбмен: метод фонового задания
Процедура ВыгрузитьОстаткиВХранилище(Знач АдресРезультата) Экспорт
    ПоместитьВоВременноеХранилище(ОстаткиВJSON(), АдресРезультата);
КонецПроцедуры

Функция ОстаткиВJSON() Экспорт  
    Результат = ОстаткиТоваров(); 
    МассивОстатков = Новый Массив();
    
    Для каждого Элемент Из Результат Цикл
        МассивОстатков.Добавить(Элемент.quantity);
    КонецЦикла;
    
    Возврат ЗначениеВСтрокуJSON(МассивОстатков);
КонецФункции

Функция ОстатокПоАртикулу(Артикул) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК Артикул,
		|	ТоварыНаСкладахОстатки.Номенклатура.Наименование КАК Наименование,
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура.Артикул = &Артикул) КАК ТоварыНаСкладахОстаткив";
	
	Запрос.УстановитьПараметр("Артикул", Артикул);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Данные = Новый Структура();
	Пока Выборка.Следующий() Цикл
		Данные.Вставить("sku", Выборка.Артикул);
		Данные.Вставить("name", Выборка.Наименование);
		Данные.Вставить("quantity", Выборка.Количество);		
	КонецЦикла;
    Возврат Данные;
	 
КонецФункции
