// Общий модуль УчебныеПодписки (флаг «Сервер»)
Процедура ПроверитьДатуДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
    Если Источник.ОбменДанными.Загрузка Тогда
        Возврат; // объект пришёл из другой базы: записываем как есть
    КонецЕсли;

    Если Источник.Дата < Дата(2026, 10, 1) Тогда
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = "Документы до 1 октября 2026 года закрыты для изменения";
        Сообщение.Сообщить();
        Отказ = Истина;
    КонецЕсли;
КонецПроцедуры
