
Функция СписокGET(Запрос)
	
	ДанныеОстатков = УчебныйОбмен.ОстаткиТоваров();
	Мин = Запрос.ПараметрыURL.Получить("min");
	Если Мин =  Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки("Параметр min неопределен");
		Возврат Ответ;
	КонецЕсли; 
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Число = ОписаниеЧисла.ПривестиЗначение(Мин); 
	Если Число = 0 Тогда
		
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки("Параметр min не число");
		Возврат Ответ;
		
	КонецЕсли;
	Для каждого Данные  Из ДанныеОстатков Цикл
		
		Если Данные.Свойство("quantity") < Число Тогда
			
			Данные.Удалить();
			
		КонецЕсли;
		
	КонецЦикла; 
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(УчебныйОбмен.ЗначениеВСтрокуJSON(ДанныеОстатков));
	Возврат Ответ;

КонецФункции

// Модуль HTTP-сервиса Остатки: шаблон «Товар» /items/{sku}, метод GET
Функция ТоварGET(Запрос)
	Артикул = Запрос.ПараметрыURL.Получить("sku");
	
	ДанныеТовара = УчебныйОбмен.ОстатокПоАртикулу(Артикул);
	Если ДанныеТовара = Неопределено Тогда
		Ответ = Новый HTTPСервисОтвет(404);
		Ответ.УстановитьТелоИзСтроки("Товар с таким артикулом не найден");
		Возврат Ответ;
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(УчебныйОбмен.ЗначениеВСтрокуJSON(ДанныеТовара));
	Возврат Ответ;
КонецФункции
