&НаСервереБезКонтекста
Процедура ЗаписатьЦенуМолока()
    ДатаЦены = Дата(2026, 9, 1);
    Товар = Справочники.Номенклатура.НайтиПоНаименованию("Молоко 1 л", Истина);
    Если Товар.Пустая() Тогда
        Сообщить("Товар «Молоко 1 л» не найден, цена не записана");
        Возврат;
    КонецЕсли;

    НаборЗаписей = РегистрыСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Номенклатура.Установить(Товар);
    НаборЗаписей.Отбор.Период.Установить(ДатаЦены);

    Запись = НаборЗаписей.Добавить();
    Запись.Период = ДатаЦены;
    Запись.Номенклатура = Товар;
    Запись.Цена = 115;

    НаборЗаписей.Записать(); // замещает записи, попадающие под отбор
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМолоко(Команда)
	ЗаписатьЦенуМолока();
КонецПроцедуры
