Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Запрос = Новый Запрос;
    Запрос.Текст =
        "ВЫБРАТЬ
        |   Товары.Номенклатура КАК Номенклатура,
        |   СУММА(Товары.Количество) КАК Количество
        |ИЗ
        |   Документ.РеализацияТоваров.Товары КАК Товары
        |ГДЕ
        |   Товары.Ссылка = &Ссылка
        |   И Товары.Номенклатура.ВидНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ВидыНоменклатуры.Товар)
        |СГРУППИРОВАТЬ ПО
        |   Товары.Номенклатура";
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Выборка = Запрос.Выполнить().Выбрать();

    // Движения по регистру остатков: реализация - это расход
    Движения.ТоварыНаСкладах.Записывать = Истина;
    Пока Выборка.Следующий() Цикл
        Движение = Движения.ТоварыНаСкладах.ДобавитьРасход();
        Движение.Период = Дата;
        Движение.Номенклатура = Выборка.Номенклатура;
        Движение.Склад = Склад;
        Движение.Количество = Выборка.Количество;
    КонецЦикла;
	// Движения по регистру оборотов: все строки, и товары, и услуги
    ЗапросПродаж = Новый Запрос;
    ЗапросПродаж.Текст =
        "ВЫБРАТЬ
        |   Товары.Номенклатура КАК Номенклатура,
        |   СУММА(Товары.Количество) КАК Количество,
        |   СУММА(Товары.Сумма) КАК Сумма
        |ИЗ
        |   Документ.РеализацияТоваров.Товары КАК Товары
        |ГДЕ
        |   Товары.Ссылка = &Ссылка
        |СГРУППИРОВАТЬ ПО
        |   Товары.Номенклатура";
    ЗапросПродаж.УстановитьПараметр("Ссылка", Ссылка);
    ВыборкаПродаж = ЗапросПродаж.Выполнить().Выбрать();

    Движения.Продажи.Записывать = Истина;
    Пока ВыборкаПродаж.Следующий() Цикл
        Движение = Движения.Продажи.Добавить();
        Движение.Период = Дата;
        Движение.Номенклатура = ВыборкаПродаж.Номенклатура;
        Движение.Контрагент = Контрагент;
        Движение.Организация = Организация;
        Движение.Количество = ВыборкаПродаж.Количество;
        Движение.Сумма = ВыборкаПродаж.Сумма;
    КонецЦикла;
         // Товары документа для отбора остатков
    ТоварыДокумента = Движения.ТоварыНаСкладах.ВыгрузитьКолонку("Номенклатура");

    // Записываем движения сами: при записи остатки по этим товарам блокируются
    Движения.ТоварыНаСкладах.БлокироватьДляИзменения = Истина;
    Движения.Записать();

    // Контроль остатков - только при оперативном проведении
    Если РежимПроведения = РежимПроведенияДокумента.Оперативный Тогда
        Запрос = Новый Запрос;
        Запрос.Текст =
            "ВЫБРАТЬ
            |   Остатки.Номенклатура КАК Номенклатура,
            |   Остатки.КоличествоОстаток КАК Остаток
            |ИЗ
            |   РегистрНакопления.ТоварыНаСкладах.Остатки(,
            |       Номенклатура В (&Товары) И Склад = &Склад) КАК Остатки
            |ГДЕ
            |   Остатки.КоличествоОстаток < 0";
        Запрос.УстановитьПараметр("Товары", ТоварыДокумента);
        Запрос.УстановитьПараметр("Склад", Склад);
        Выборка = Запрос.Выполнить().Выбрать();

        Пока Выборка.Следующий() Цикл
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = СтрШаблон("Не хватает %1 ед. товара «%2» на складе",
                -Выборка.Остаток, Выборка.Номенклатура);
            Сообщение.Сообщить();
            Отказ = Истина;
        КонецЦикла;
    КонецЕсли;

КонецПроцедуры

